# MCCIA Approvals: copy this file to .env and change what you need. Every value is optional; the defaults suit local use.

# Port the server listens on (the dev client on :5173 forwards /api to this one).
PORT=3001

# Where the SQLite database file and the uploaded files are kept. The defaults are database/mccia.db and uploads/ inside this folder.
# Point both at a persistent disk when you deploy. (Vercel's serverless functions have no persistent disk; see README.)
# DB_FILE=/var/data/mccia.db
# UPLOAD_DIR=/var/data/uploads

# The key that signs login sessions. If you leave it out, a random one is created once and kept in database/.secret.
# Set it explicitly when more than one server instance runs, so they all accept the same sessions.
# SESSION_SECRET=
