DATABASE_URL=
DB_DRIVER=neon
DATABASE_SSL=true

# Signs the login cookie. Make one with: openssl rand -base64 32
AUTH_SECRET=

# The main admin. Signs in with this email and HEAD_ADMIN_PASSWORD; everyone else is created in Administrator.
HEAD_ADMIN_EMAIL=
HEAD_ADMIN_NAME=
# At least 10 characters, a letter and a number. Change it here (and redeploy) to change it.
HEAD_ADMIN_PASSWORD=

# Optional. Comma-separated email domains users may have (for example example.com,gmail.com). Empty means any domain.
ALLOWED_EMAIL_DOMAIN=

# --- Approvals module (/approvals) ---
# true turns it on. Unset or anything else: every /approvals route returns 404 and the hub hides the Approvals card.
APPROVALS_ENABLED=true
# Starting value of the "10,000 and above" threshold, in paise (1000000 = 10,000 rupees). After the first seed it is edited in Approvals > Settings.
APPROVALS_THRESHOLD_PAISE=1000000
# Read only by the approvals seed (npm run db:seed:approvals). These people must already be users in the hub.
APPROVALS_HR_APPROVER_EMAIL=
APPROVALS_EXPENDITURE_APPROVER_EMAIL=
APPROVALS_DG_EMAIL=
# Email notifications (optional). Without SMTP_HOST and SMTP_FROM no email is sent; the in-app bell still works.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="MCCIA Approvals <approvals@example.com>"
# The address of this site, used for the links inside emails (no trailing slash).
# APP_BASE_URL=https://your-hub-domain
