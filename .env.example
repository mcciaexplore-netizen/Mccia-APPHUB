DATABASE_URL=
DB_DRIVER=neon
DATABASE_SSL=true

AUTH_SECRET=

# The only account set here. Everyone else (Super Admin, HR Admin, Expense Admin, Admins, users) is added in the app.
SUPPORT_ADMIN_EMAIL=
SUPPORT_ADMIN_NAME=
SUPPORT_ADMIN_PASSWORD=

ALLOWED_EMAIL_DOMAIN=

APPROVALS_THRESHOLD_PAISE=1000000


APP_BASE_URL=

# Email: the Support Admin's Zoho mailbox. SMTP_PASS is a Zoho APP password (accounts.zoho.in > Security > App Passwords), not the normal one.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MCCIA App Hub <your-zoho-address@mcciapune.com>
