DATABASE_URL=
DB_DRIVER=neon
DATABASE_SSL=true
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Comma-separated list of email domains that may be added as users. Empty means mcciapune.com,gmail.com.
ALLOWED_EMAIL_DOMAIN=mcciapune.com,gmail.com
HEAD_ADMIN_EMAIL=
HEAD_ADMIN_NAME=
# Optional. If empty, the seed generates a temporary password and prints it once.
HEAD_ADMIN_TEMP_PASSWORD=

# Local dev only: open the hub as HEAD_ADMIN_EMAIL without signing in (ignored in production builds)
DEV_AUTH_BYPASS=false

# Optional test login (signs in as HEAD_ADMIN_EMAIL). Leave empty in production.
TEST_LOGIN_USER=
TEST_LOGIN_PASSWORD=
