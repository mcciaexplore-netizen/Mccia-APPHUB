# ─── Database (Supabase) ────────────────────────────────────────
# Switch from Neon to Supabase (see docs/SUPABASE-MIGRATION.md). Until the switch, production keeps its Neon DATABASE_URL and DB_DRIVER=neon.
# Get this from Supabase → Connect → Transaction pooler (port 6543). The user is postgres.<project-ref>, and the host is the pooler,
# not db.<project-ref>.supabase.co (that one is IPv6 only, which Vercel cannot reach). An ?sslmode=... on it is ignored.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Use pg driver for Supabase (not neon). It is always encrypted to a remote database; Supabase's own certificate is not checked
# (Node does not know its authority). DATABASE_SSL is no longer read.
DB_DRIVER=pg

# Optional: connections per server instance (default 5). Keep it small with the transaction pooler.
# DB_POOL_MAX=5

AUTH_SECRET=

# The only account set here. Everyone else (Super Admin, HR Admin, Expense Admin, Admins, users) is added in the app.
SUPPORT_ADMIN_EMAIL=
SUPPORT_ADMIN_NAME=
SUPPORT_ADMIN_PASSWORD=

ALLOWED_EMAIL_DOMAIN=

APPROVALS_THRESHOLD_PAISE=1000000

# Inventory module: off unless set to true. Run scripts/apply-0021-inventory-in-neon-console.sql in Neon (production branch) first.
INVENTORY_ENABLED=false

APP_BASE_URL=

# Email: the Support Admin's Zoho mailbox. SMTP_PASS is a Zoho APP password (accounts.zoho.in > Security > App Passwords), not the normal one.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MCCIA App Hub <your-zoho-address@mcciapune.com>

# Single sign-on (SSO): the hub's private signing key. It signs the short-lived token the hub posts to an application with SSO switched on.
# It is the base64 of a PKCS8 PEM Ed25519 private key, on ONE line. Make a pair with:  node scripts/sso-keygen.mjs <an empty folder outside the project>
# That writes sso-private.b64 (paste its contents here, in the hosting settings, never in git) and sso-public.b64 (the application verifies tokens with this).
# Without it, opening an SSO application shows "Single sign-on is not set up"; everything else in the hub keeps working.
SSO_PRIVATE_KEY=

# IVR-CRM (the Membership team's calling CRM, /ivr and /ivr/admin): off unless set to true. Run scripts/apply-0036-ivr.sql in the production
# database first. Then add the two applications in Administrator → Applications: "IVR-CRM" (address /ivr) and "IVR-CRM Admin" (/ivr/admin).
IVR_ENABLED=false
# Encrypts the stored Smartflo login and the agents' Zoho tokens. Long and random, 32+ characters; never change it once in use (the stored
# credentials could no longer be read). Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
IVR_ENCRYPTION_KEY=
# Tata Smartflo. "live" talks to Smartflo; "mock" makes sample calls (the default outside production).
SMARTFLO_MODE=live
# Part of the webhook address Smartflo posts to: /api/ivr/webhooks/smartflo/<this value>. Smartflo does not sign webhooks, so keep it private.
SMARTFLO_WEBHOOK_SECRET=
# Optional: the number (your Smartflo DID) members see on calls placed from the Call button.
# SMARTFLO_CALLER_ID=+912071000000
# Only change if Tata gives you a different API host.
# SMARTFLO_API_BASE=https://api-smartflo.tatateleservices.com
# Zoho Mail for the agents' own mailboxes (see docs/ivr-zoho-setup.md).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_DOMAIN=zoho.in
# The daily IVR-CRM sync (vercel.json → /api/cron/ivr-sync) checks CRON_SECRET, the same one the uploads clean-up cron uses. Vercel sends it
# itself; without it both crons refuse everyone.
# CRON_SECRET=
