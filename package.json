{
  "name": "mccia-app-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:approvals": "tsx scripts/seed-approvals.ts",
    "typecheck": "tsc --noEmit",
    "clean:scan": "node scripts/cleanup.mjs",
    "clean:fix": "node scripts/cleanup.mjs --fix",
    "test:unit": "tsx tests/unit.ts",
    "test:integration": "tsx --require ./tests/stub-server-only.cjs tests/integration.mts",
    "test:integration:hub": "tsx --require ./tests/stub-server-only.cjs tests/hub-integration.mts",
    "test:e2e": "node tests/e2e/suite.mjs",
    "test:e2e:people": "node tests/e2e/people.mjs",
    "test:e2e:roles": "node tests/e2e/roles.mjs",
    "test:load:seed": "tsx --require ./tests/stub-server-only.cjs tests/load/seed.mts",
    "test:load": "node tests/load/run.mjs",
    "test:load:write": "tsx --require ./tests/stub-server-only.cjs tests/load/write-load.mts",
    "test:e2e:approvals": "node tests/e2e/approvals.mjs",
    "test:e2e:approvals:flow": "node tests/e2e/approvals-flow.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "jose": "^6.2.13",
    "lucide-react": "^1.48.0",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "knip": "^6.39.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
